generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RETAILER
  ADMIN
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum DispatchMethod {
  DELHIVERY
  TRANSPORT
}

enum ShippingStatus {
  PENDING
  PACKED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

model User {
  id        String     @id @default(cuid())
  email     String?    @unique
  mobile    String?    @unique
  name      String?
  passwordHash String?
  role      UserRole   @default(CUSTOMER)
  retailer  Retailer?
  addresses Address[]
  carts     Cart[]
  orders    Order[]
  wishlists Wishlist[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Retailer {
    id         String      @id @default(cuid())
    userId     String      @unique
    shopName   String
    ownerName  String
    gstin      String?     @unique
    mobile     String
    email      String?
    address    String
    city       String
    state      String
    pincode    String

    // B2B account approval
    isApproved Boolean     @default(false)

    user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    quotations Quotation[]

    @@index([city, state])
    @@index([isApproved])
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  brands    Brand[]
  createdAt DateTime @default(now())
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  mobile    String?
  email     String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id             String        @id @default(cuid())
  name           String        @unique
  slug           String        @unique
  isDemo         Boolean       @default(true)
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  products       Product[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model PackSize {
  id       String           @id @default(cuid())
  label    String           @unique
  grams    Int
  variants ProductVariant[]

  @@index([grams])
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String?
  imageUrl       String?
  isDemo         Boolean          @default(true)
  isActive       Boolean          @default(true)
  brandId        String
  brand          Brand            @relation(fields: [brandId], references: [id])
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  variants       ProductVariant[]
  quotationItems QuotationItem[]
  wishlists      Wishlist[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([brandId, categoryId, isActive])
}

model ProductVariant {
  id           String      @id @default(cuid())
  sku          String      @unique
  price        Decimal     @db.Decimal(10, 2)
  mrp          Decimal?    @db.Decimal(10, 2)
  specialPrice Decimal?    @db.Decimal(10, 2)
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  packSizeId   String
  packSize     PackSize    @relation(fields: [packSizeId], references: [id])
  inventory    Inventory?
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([productId, packSizeId])
}

model Inventory {
  id        String          @id @default(cuid())
  variantId String          @unique
  quantity  Int             @default(0)
  status    InventoryStatus @default(IN_STOCK)
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt DateTime        @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  sessionId String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  orders    Order[]
}

model Order {
  id                 String         @id @default(cuid())
  orderNumber        String         @unique
  userId             String?
  user               User?          @relation(fields: [userId], references: [id])
  addressId          String?
  address            Address?       @relation(fields: [addressId], references: [id])
  status             OrderStatus    @default(PENDING)
  items              OrderItem[]
  payments           Payment[]
  total         Decimal @db.Decimal(12, 2)
courierCharge Decimal @default(0) @db.Decimal(10, 2)
grandTotal    Decimal @default(0) @db.Decimal(12, 2)

  // Guest/customer order snapshot
  customerName       String?
  customerMobile     String?
  customerEmail      String?
  shippingAddress1   String?
  shippingAddress2   String?
  shippingCity       String?
  shippingState      String?
  shippingPincode    String?

  // Dispatch — only DELHIVERY or TRANSPORT
  dispatchMethod     DispatchMethod?
  shippingStatus     ShippingStatus @default(PENDING)
  awbNumber          String?        @unique
  transportName      String?
  lrNumber           String?
  packageCount       Int?
  totalWeight        Decimal?       @db.Decimal(10, 2)
  trackingUrl        String?
  dispatchDate       DateTime?
  deliveryDate       DateTime?
  dispatchNotes      String?
  invoiceNumber      String?        @unique
  invoiceDate        DateTime?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId, status])
  @@index([shippingStatus, dispatchMethod])
  @@index([customerMobile])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  productName   String
  brandName     String
  packSizeLabel String
  unitPrice     Decimal         @db.Decimal(10, 2)
  quantity      Int

  @@index([orderId])
}

model Quotation {
  id           String          @id @default(cuid())
  retailerId   String?
  retailer     Retailer?       @relation(fields: [retailerId], references: [id])
  customerName String
  shopName     String?
  mobile       String
  deliveryCity String
  message      String?
  items        QuotationItem[]
  createdAt    DateTime        @default(now())

  @@index([mobile, createdAt])
}

model QuotationItem {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  brandName     String
  packSizeLabel String
  quantity      Int
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  reference String?       @unique
  createdAt DateTime      @default(now())

  @@index([orderId, status])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
